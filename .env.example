# Client-only flag. Do not put OPENAI_API_KEY in any VITE_ variable.
# On Vercel, set OPENAI_API_KEY in the project Environment Variables, then:
# VITE_IMAGE_PROXY=1
VITE_IMAGE_PROXY=

# Production chat bridge (Hugging Face Space). Optional — the client already
# falls back to this URL when vault + env are empty. Vercel is unused for chat.
VITE_CHAT_API_BASE=https://simzy-command-center-chat.hf.space
# Local demo only. Leave unset so Chat talks to Chief of Staff for real.
# VITE_CHAT_MOCK=1
