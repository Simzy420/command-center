# Client-only flag. Do not put OPENAI_API_KEY in any VITE_ variable.
# On Vercel, set OPENAI_API_KEY in the project Environment Variables, then:
# VITE_IMAGE_PROXY=1
VITE_IMAGE_PROXY=

# Production chat bridge (Hugging Face Space). Optional — the client already
# falls back to this URL when vault + env are empty. Vercel is unused for chat.
VITE_CHAT_API_BASE=https://simzy-command-center-chat.hf.space
# Local demo only. Leave unset so Chat talks to Chief of Staff for real.
# VITE_CHAT_MOCK=1

# Optional. Leave unset. The watchlist calls https://api.coingecko.com/api/v3
# from the browser (CORS is open). Set this only to a root that serves the same
# /simple/price and /search paths. No market API key.
# VITE_MARKET_API_BASE=

# Optional Wan 2.2 Extend Space (stitch / auto-extend). Unset uses the public
# Space https://simzy-wan22-extend.hf.space — no token in the client.
# VITE_WAN_EXTEND_ORIGIN=https://simzy-wan22-extend.hf.space
