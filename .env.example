# Client-only flag. Do not put OPENAI_API_KEY in any VITE_ variable.
# On Vercel, set OPENAI_API_KEY in the project Environment Variables, then:
# VITE_IMAGE_PROXY=1
VITE_IMAGE_PROXY=

# Become the Character (Swapr) Runpod controls. Server-only — never put these in VITE_.
# On Vercel: set RUNPOD_API_KEY (and optional RUNPOD_ENDPOINT_ID, default zrmwpir4qzs66s).
# That powers /api/runpod-status (live balance) and /api/runpod-stop (Stop GPU).
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=zrmwpir4qzs66s
# Optional when the UI is on GitHub Pages but APIs live on a Vercel deployment:
# VITE_RUNPOD_API_BASE=https://your-command-center.vercel.app

# Production chat bridge (Hugging Face Space). Optional — the client already
# falls back to this URL when vault + env are empty. Vercel is unused for chat.
VITE_CHAT_API_BASE=https://simzy-command-center-chat.hf.space
# Local demo only. Leave unset so Chat talks to Chief of Staff for real.
# VITE_CHAT_MOCK=1

# Optional. Leave unset. The watchlist calls https://api.coingecko.com/api/v3
# from the browser (CORS is open). Set this only to a root that serves the same
# /simple/price and /search paths. No market API key.
# VITE_MARKET_API_BASE=

# Robinhood widget polls GET {chat Space}/api/robinhood. Leave unset to follow
# the chat bridge origin above (vault → VITE_CHAT_API_BASE → default Space).
# Optional origin override only. Never put a Robinhood login or
# ROBINHOOD_BRIDGE_SECRET in any VITE_ variable — that secret lives on the Space.
# VITE_ROBINHOOD_API_BASE=
